    {
      "name": "Rangers",
      "item": [
        {
          "name": "List Rangers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rangers?park_id=1",
              "host": ["{{base_url}}"],
              "path": ["rangers"],
              "query": [{ "key": "park_id", "value": "1", "disabled": true }]
            },
            "description": "Ranger accounts are created via Users > Invite Personnel or Gamepark > Invite Personnel (role_id = Ranger), not a dedicated create-ranger endpoint - both routes provision the Firebase Auth account behind the scenes so the ranger can sign in to the mobile app with the invited email."
          }
        }
      ]
    },
    {
      "name": "Incidents",
      "item": [
        {
          "name": "List Incidents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/incidents?park_id=1&status=New&escalated=false&incident_type=Crop Damage&from=2026-01-01&to=2026-12-31&per_page=25",
              "host": ["{{base_url}}"],
              "path": ["incidents"],
              "query": [
                { "key": "park_id", "value": "1", "disabled": true },
                { "key": "status", "value": "New", "disabled": true },
                { "key": "escalated", "value": "false", "disabled": true },
                { "key": "incident_type", "value": "Crop Damage", "disabled": true },
                { "key": "from", "value": "2026-01-01", "disabled": true },
                { "key": "to", "value": "2026-12-31", "disabled": true },
                { "key": "per_page", "value": "25" }
              ]
            }
          }
        },
        {
          "name": "Get Incident",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/incidents/1", "host": ["{{base_url}}"], "path": ["incidents", "1"] }
          }
        },
        {
          "name": "Create Incident",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reported_by\": 1,\n  \"park_id\": 1,\n  \"incident_type\": \"Crop Damage\",\n  \"description\": \"Elephants raided a banana plantation overnight.\",\n  \"latitude\": -1.05,\n  \"longitude\": 29.7,\n  \"village\": \"Buhoma\"\n}"
            },
            "url": { "raw": "{{base_url}}/incidents", "host": ["{{base_url}}"], "path": ["incidents"] },
            "description": "incident_type must be one of: Wildlife Sighting, Crop Damage, Livestock Loss, Property Damage, Human Injury, Human Fatality."
          }
        },
        {
          "name": "Update Incident Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Assigned\",\n  \"is_escalated\": false,\n  \"remarks\": \"Ranger dispatched.\"\n}"
            },
            "url": { "raw": "{{base_url}}/incidents/1/status", "host": ["{{base_url}}"], "path": ["incidents", "1", "status"] },
            "description": "status is one of New, Assigned, In Progress, Resolved. Either status or is_escalated must be present (both are individually optional otherwise) - see IncidentController::updateStatus."
          }
        },
        {
          "name": "Assign Incident",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ranger_id\": 2\n}"
            },
            "url": { "raw": "{{base_url}}/incidents/1/assign", "host": ["{{base_url}}"], "path": ["incidents", "1", "assign"] }
          }
        },
        {
          "name": "Delete Incident",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/incidents/1", "host": ["{{base_url}}"], "path": ["incidents", "1"] }
          }
        }
      ]
    },
