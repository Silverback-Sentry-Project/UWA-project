          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/parks", "host": ["{{base_url}}"], "path": ["parks"] }
          }
        },
        {
          "name": "List Species",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/species", "host": ["{{base_url}}"], "path": ["species"] }
          }
        },
        {
          "name": "List Roles",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/roles", "host": ["{{base_url}}"], "path": ["roles"] }
