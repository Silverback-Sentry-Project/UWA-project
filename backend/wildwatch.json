{
  "info": {
    "name": "WildWatch Portal API",
    "description": "Covers the full web-portal/backend API surface (routes/api.php): admin-portal auth, incidents, SOS alerts, users/rangers, news articles, compensation claims, forwarded forms, the Gamepark portal, and the Firebase→Laravel webhook bridge. See BRIDGE-CONTRACT.md for the bridge's field-mapping contract and REPOS.md/AGENTS.md for the wider project map.\n\nSetup:\n1. Run the 'Login' request first (Auth folder) - its test script saves the returned token into the `bearer_token` collection variable automatically, so every other authenticated request just works afterward.\n2. Webhook requests sign themselves automatically from the `webhook_secret` collection variable (see the Webhooks folder's pre-request script) - set it to match `FIREBASE_BRIDGE_SECRET` in your backend/.env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api", "type": "string" },
    { "key": "bearer_token", "value": "", "type": "string" },
    { "key": "webhook_secret", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@wildwatch.app\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] },
            "description": "Only System Administrator / UWA Official accounts can sign into the admin portal (see AuthController::login); Gamepark accounts authenticate the same way but are scoped by role middleware on individual routes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.token) {",
                  "        pm.collectionVariables.set('bearer_token', body.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
          }
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "List Public Parks",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/public/parks", "host": ["{{base_url}}"], "path": ["public", "parks"] },
            "description": "Unauthenticated - populates the park picker on the sign-in screen before login. Returns only park_id/park_name."
          }
        }
      ]
    },
    {
      "name": "Webhooks (Firebase → Laravel bridge)",
      "description": "HMAC-signed, outside Sanctum entirely (see BRIDGE-CONTRACT.md and VerifyWebhookSignature middleware). The pre-request script below computes X-WildWatch-Signature from the raw request body and the `webhook_secret` collection variable, exactly like functions/src/bridge.ts's signPayload() does on the Cloud Functions side - set `webhook_secret` to match your backend/.env's FIREBASE_BRIDGE_SECRET before using these.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const secret = pm.collectionVariables.get('webhook_secret');",
              "const body = pm.request.body && pm.request.body.raw ? pm.request.body.raw : '';",
              "if (secret && body) {",
              "    const digest = CryptoJS.HmacSHA256(body, secret).toString();",
              "    pm.request.headers.upsert({ key: 'X-WildWatch-Signature', value: `sha256=${digest}` });",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Incident Webhook (create/update/delete)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"docId\": \"firestore-inc-001\",\n  \"eventType\": \"create\",\n  \"after\": {\n    \"type\": \"conflict\",\n    \"status\": \"open\",\n    \"park\": \"Bwindi Impenetrable National Park\",\n    \"summary\": \"Crop damage near village\",\n    \"lat\": -1.05,\n    \"lng\": 29.7,\n    \"community\": \"Buhoma\",\n    \"district\": \"Kanungu\",\n    \"severity\": \"medium\",\n    \"isEscalated\": false,\n    \"reportedAt\": \"2026-08-12T09:00:00Z\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/webhooks/incidents", "host": ["{{base_url}}"], "path": ["webhooks", "incidents"] },
            "description": "eventType is one of create/update/delete (see WebhookController::handleUpsert). For a delete, omit 'after' and set eventType to \"delete\" - only docId is required then."
          }
        },
        {
          "name": "Sighting Webhook (create/update/delete)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"docId\": \"firestore-sighting-001\",\n  \"eventType\": \"create\",\n  \"after\": {\n    \"park\": \"Bwindi Impenetrable National Park\",\n    \"lat\": -1.05,\n    \"lng\": 29.7,\n    \"count\": 3,\n    \"notes\": \"Family group near the trailhead\",\n    \"ranger_uid\": null,\n    \"approval_status\": \"pending\",\n    \"reportedAt\": \"2026-08-12T09:00:00Z\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/webhooks/sightings", "host": ["{{base_url}}"], "path": ["webhooks", "sightings"] }
          }
        },
        {
          "name": "SOS Alert Webhook (create/update/delete)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"docId\": \"firestore-sos-001\",\n  \"eventType\": \"create\",\n  \"after\": {\n    \"park\": \"Bwindi Impenetrable National Park\",\n    \"lat\": -1.05,\n    \"lng\": 29.7,\n    \"status\": \"open\",\n    \"reportedAt\": \"2026-08-12T09:00:00Z\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/webhooks/sos-alerts", "host": ["{{base_url}}"], "path": ["webhooks", "sos-alerts"] }
          }
        }
      ]
    },
    {
