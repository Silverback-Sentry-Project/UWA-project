    {
      "name": "Gamepark - Evidence Forms",
      "item": [
        {
          "name": "List Forms",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/gamepark/forms", "host": ["{{base_url}}"], "path": ["gamepark", "forms"] }
          }
        },
        {
          "name": "Get Form",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/gamepark/forms/1", "host": ["{{base_url}}"], "path": ["gamepark", "forms", "1"] }
          }
        },
        {
          "name": "Create Form",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Crop Damage Evidence Form\",\n  \"description\": \"Collected from residents reporting crop damage.\",\n  \"status\": \"Draft\",\n  \"fields\": [\n    { \"label\": \"Description of damage\", \"field_type\": \"textarea\", \"is_required\": true },\n    { \"label\": \"Estimated area affected (acres)\", \"field_type\": \"number\", \"is_required\": true },\n    { \"label\": \"Photo evidence\", \"field_type\": \"image\", \"is_required\": false },\n    { \"label\": \"Crop type\", \"field_type\": \"select\", \"options\": [\"Banana\", \"Maize\", \"Coffee\", \"Other\"], \"is_required\": true }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/gamepark/forms", "host": ["{{base_url}}"], "path": ["gamepark", "forms"] },
            "description": "field_type is one of text, textarea, number, date, select, image. status is Draft or Published (defaults to Draft)."
          }
        },
