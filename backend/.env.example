APP_NAME="WildWatch Admin API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Postgres (Neon) is the hosted target - see ../HOSTED-CUTOVER-PLAN.md. SQLite is what the
# automated test suite uses (phpunit.xml sets DB_CONNECTION=sqlite/:memory: directly); MySQL
# still works if running against the old local setup, but is no longer the default here.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wildwatch
DB_USERNAME=wildwatch
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# The portal frontend calls this API from a different origin — add its real deployed URL
# here (e.g. a Cloudflare Workers URL) in addition to any local dev URLs.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# LAN testing — auto-extends Sanctum/CORS when set (see config/dev.php)
DEV_LAN_HOST=
DEV_LAN_FRONTEND_PORT=5173
DEV_LAN_API_PORT=8000

# Shared HMAC secret for Firebase Functions → Laravel webhook calls. Must match
# FIREBASE_BRIDGE_SECRET in the Cloud Functions environment exactly - rotate both together.
FIREBASE_BRIDGE_SECRET=

# Firebase emulator hosts — only set these if actually running the Firebase emulator suite
# locally (see android-native-backend-branch/README.md). Leave blank against a real project.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# Mail (Resend) — personnel invite emails. Leave MAIL_MAILER unset/blank to fall back to the
# "log" driver (invites still succeed and log a warning instead of sending — see
# UserController::sendInvite) rather than failing outright if RESEND_API_KEY isn't set yet.
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@wildwatch.app"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
